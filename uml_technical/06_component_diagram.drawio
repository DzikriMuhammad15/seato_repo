<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram id="pg1" name="CP-01 Arsitektur Komponen"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg1-1" value="CP-01 · Component Diagram – Arsitektur Komponen Sistem SEATO" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="30" as="geometry"/></mxCell><mxCell id="pg1-2" value="Satu aplikasi Next.js 16 (App Router) berisi klien React dan REST API; lapisan server (src/server) untuk AI insight, email &amp;amp; scheduler; Prisma ORM ke PostgreSQL (Supabase); layanan eksternal OpenAI / Anthropic / Resend; Vercel Cron." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1700" height="34" as="geometry"/></mxCell><mxCell id="pg1-3" value="«subsystem»&lt;br&gt;&lt;b&gt;Aplikasi Pelanggan&lt;/b&gt;&lt;div style=&quot;font-size:9px;margin-top:4px;color:#333&quot;&gt;Route &quot;/&quot; (src/app/page.jsx)&lt;br&gt;screens/*, components/ui/*, components/layout/*&lt;br&gt;React 19, Mantine, react-hot-toast, react-qr-code&lt;br&gt;State sesi: currentUser di memori&lt;/div&gt;" style="html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontFamily=Helvetica;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="260" height="300" as="geometry"/></mxCell><mxCell id="pg1-4" value="" style="shape=component;jettyWidth=8;jettyHeight=4;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="294" y="126" width="18" height="16" as="geometry"/></mxCell><mxCell id="pg1-5" value="«subsystem»&lt;br&gt;&lt;b&gt;Partner Portal&lt;/b&gt;&lt;div style=&quot;font-size:9px;margin-top:4px;color:#333&quot;&gt;Route &quot;/admin/*&quot; (src/app/admin)&lt;br&gt;Dashboard BI, Reservations, Zonasi Meja, Promos&lt;br&gt;AdminSidebar, AdminLayout&lt;br&gt;Sesi: partnerRestoId di localStorage&lt;/div&gt;" style="html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontFamily=Helvetica;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="260" height="230" as="geometry"/></mxCell><mxCell id="pg1-6" value="" style="shape=component;jettyWidth=8;jettyHeight=4;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="294" y="476" width="18" height="16" as="geometry"/></mxCell><mxCell id="pg1-7" value="Super Admin&lt;br&gt;(klien HTTP)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="172" y="745" width="36" height="70" as="geometry"/></mxCell><mxCell id="pg1-8" value="«external»&lt;br&gt;&lt;b&gt;Vercel Cron&lt;/b&gt;&lt;div style=&quot;font-size:9px;margin-top:4px;color:#333&quot;&gt;vercel.json: auto-cancel */10 * * * *&lt;br&gt;market-scraper 0 19 * * *&lt;br&gt;generate-ai-digest 0 0 * * 1&lt;/div&gt;" style="html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=10;fontFamily=Helvetica;fillColor=#F8CECC;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="260" height="90" as="geometry"/></mxCell><mxCell id="pg1-9" value="" style="shape=component;jettyWidth=8;jettyHeight=4;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="294" y="926" width="18" height="16" as="geometry"/></mxCell><mxCell id="pg1-10" value="«component»&lt;br&gt;&lt;