<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram id="pg1" name="SM-01 Status Reservasi"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg1-1" value="SM-01 · State Machine Diagram – Siklus Status Reservasi" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="pg1-2" value="Nilai Reservation.status dan transisinya sesuai POST /api/reservations, PATCH /api/reservations/[id], checkAutoTerminate() dan CronJobs.autoCancelLateReservations()." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="34" as="geometry"/></mxCell><mxCell id="pg1-3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="302" y="108" width="26" height="26" as="geometry"/></mxCell><mxCell id="pg1-4" value="&lt;b&gt;Menunggu Konfirmasi&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / invoiceId = INV-yyyyMMdd-XXXX, totalAmount = tamu × 50.000, paymentStatus = &quot;Unpaid&quot;, statsReservasi + 1&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="180" y="210" width="270" height="120" as="geometry"/></mxCell><mxCell id="pg1-5" value="&lt;b&gt;Confirmed&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / assignedTable disimpan (meja dipilih Partner)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="260" height="120" as="geometry"/></mxCell><mxCell id="pg1-6" value="&lt;b&gt;Sedang Makan&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;tamu sudah check-in; okupansi tetap&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="220" width="240" height="90" as="geometry"/></mxCell><mxCell id="pg1-7" value="&lt;b&gt;Selesai&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / XPLog dibuat, xpPoints &amp;amp; level diperbarui&lt;br&gt;dapat diulas (1 ulasan per reservasi)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="640" width="300" height="110" as="geometry"/></mxCell><mxCell id="pg1-8" value="&lt;b&gt;Dibatalkan&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / simpan cancelReason &amp;amp; cancelledBy (user | admin | system)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="640" width="300" height="110" as="geometry"/></mxCell><mxCell id="pg1-9" value="&lt;b&gt;Ditolak Restoran&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;cancelledBy = &quot;admin&quot;; okupansi &amp;amp; cancelCount tidak berubah&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11