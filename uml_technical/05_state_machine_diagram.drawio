id="pg3-33" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1356" y="319.0" width="64" height="24" as="geometry"/></mxCell><mxCell id="pg3-34" value="Composite state (berisi sub-state)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1436" y="314" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg3-35" value="Setiap perubahan dikirim ke PATCH /api/restaurants/{id}/areas {field, delta, assignments}. Bila server menolak (melanggar batas), UI memuat ulang area dari server sehingga meja kembali ke status sebenarnya." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="380" width="300" height="90" as="geometry"/></mxCell><mxCell id="pg3-36" value="Timer hanya untuk meja walk-in (diperiksa setiap 2 detik). 10 detik adalah nilai pengujian; komentar kode menyebut 5 menit untuk produksi." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="490" width="300" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg4" name="SM-04 Level &amp; Gelar Pelanggan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg4-1" value="SM-04 · State Machine Diagram – Gelar Level Pelanggan (Gamifikasi XP)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="pg4-2" value="Ambang XP dari LEVEL_THRESHOLDS (src/app/api/profile/xp, reviews, reservations/[id], LevelProgressBar.jsx). Level dihitung ulang setiap XP bertambah." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1300" height="34" as="geometry"/></mxCell><mxCell id="pg4-3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="267" y="104" width="26" height="26" as="geometry"/></mxCell><mxCell id="pg4-4" value="&lt;b&gt;Newcomer&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;Level 1–4 · 0 XP&lt;br&gt;XP bertambah / level = hitungLevel(xpPoints)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="160" width="280" height="96" as="geometry"/></mxCell><mxCell id="pg4-5" value="&lt;b&gt;Explorer&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;Level 5–9 · ≥ 500 XP&lt;br&gt;XP bertambah / level = hitungLevel(xpPoints)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="280" height="96" as="geometry"/></mxCell><mxCell id="pg4-6" value="&lt;b&gt;Enthusiast&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;Level 10–14 · ≥ 2.000 XP&lt;br&gt;XP bertambah / level = hitungLevel(xpPoints)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="280" height="96" as="geometry"/></mxCell><mxCell id="pg4-7" value="&lt;b&gt;Connoisseur&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;Level 15–19 · ≥ 5.000 XP&lt;br&gt;XP bertambah / level = hitungLevel(xpPoints)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="280" height="96" as="geometry"/></mxCell><mxCell id="pg4-8" value="&lt;b&gt;Master Hopper&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;Level 20–24 · ≥ 10.000 XP&lt;br&gt;XP bertambah / level = hitungLevel(xpPoints)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="280" height="96" as="geometry"/></mxCell><mxCell id="pg4-9" value="&lt;b&gt;Legend Hopper&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;Level 25 (maks.) · ≥ 20.000 XP&lt;br&gt;XP bertambah / level = hitungLevel(xpPoints)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="420" width="280" height="96" as="geometry"/></mxCell><mxCell id="pg4-10" value="akun dibuat (xpPoints = 0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg4-3" target="pg4-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg4-11" value="XP bertambah&lt;br&gt;[xpPoints ≥ 500]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg4-4" target="pg4-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg4-12" value="XP bertambah&lt;br&gt;[xpPoints ≥ 2.000]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg4-5" target="pg4-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg4-13" value="XP bertambah [xpPoints ≥ 5.000]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg4-6" target="pg4-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg4-14" value="XP bertambah&lt;br&gt;[xpPoints ≥ 10.000]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg4-7" target="pg4-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg4-15" value="XP bertambah&lt;br&gt;[xpPoints ≥ 20.000]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg4-8" target="pg4-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg4-16" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="300" height="214" as="geometry"/></mxCell><mxCell id="pg4-17" value="&lt;b&gt;Legenda / Notasi UML&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1248" y="114" width="284" height="26" as="geometry"/></mxCell><mxCell id="pg4-18" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1278" y="151.0" width="20" height="20" as="geometry"/></mxCell><mxCell id="pg4-19" value="Initial pseudostate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1336" y="144" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg4-20" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1277" y="184.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="pg4-21" value="Final state" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1336" y="178" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg4-22" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1256" y="217.0" width="64" height="24" as="geometry"/></mxCell><mxCell id="pg4-23" value="State (nama + aktivitas internal)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1336" y="212" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg4-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1252" y="263.0" as="sourcePoint"/><mxPoint x="1324" y="263.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg4-25" value="Transisi: event [guard] / effect" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1336" y="246" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg4-26" value="" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1268" y="285.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="pg4-27" value="Catatan" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1336" y="280" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg4-28" value="&lt;b&gt;Sumber XP (sesuai kode):&lt;/b&gt;&lt;br&gt;• Check-out reservasi: +15 (FIRST_VISIT) atau +5 (CHECK_IN)&lt;br&gt;• Memberi ulasan: +10 (REVIEW)&lt;br&gt;• POST /api/profile/xp (umum, belum dipanggil UI)&lt;br&gt;Panduan XP di aplikasi juga menyebut foto, ulasan disukai &amp;amp; kunjungan ulang (belum diimplementasi)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="580" width="520" height="100" as="geometry"/></mxCell><mxCell id="pg4-29" value="hitungLevel(): level naik bertahap di antara ambang, mis. 1→5 dalam 500 XP = 125 XP per level; dibatasi maksimal 25. XP tidak pernah berkurang sehingga tidak ada transisi turun." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="480" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>