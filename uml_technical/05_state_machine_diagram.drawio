y="184.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="pg1-32" value="Final state" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1616" y="178" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg1-33" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1536" y="217.0" width="64" height="24" as="geometry"/></mxCell><mxCell id="pg1-34" value="State (nama + aktivitas internal)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1616" y="212" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg1-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1532" y="263.0" as="sourcePoint"/><mxPoint x="1604" y="263.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg1-36" value="Transisi: event [guard] / effect" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1616" y="246" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg1-37" value="" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1548" y="285.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="pg1-38" value="Catatan" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1616" y="280" width="196" height="34" as="geometry"/></mxCell><mxCell id="pg1-39" value="&lt;b&gt;Tampilan di aplikasi pelanggan&lt;/b&gt; (GET /api/reservations):&lt;br&gt;• Upcoming = Menunggu Konfirmasi, Confirmed&lt;br&gt;• Selesai = Selesai&lt;br&gt;• Dibatalkan = Dibatalkan, Ditolak Restoran&lt;br&gt;• &lt;i&gt;Sedang Makan&lt;/i&gt; tidak masuk kategori mana pun." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="330" width="300" height="110" as="geometry"/></mxCell><mxCell id="pg1-40" value="Batal otomatis (No-Show) dijalankan oleh Vercel Cron setiap 10 menit dan saat daftar reservasi dimuat (syarat tambahan: updatedAt &amp;gt; 1 menit)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="460" width="300" height="70" as="geometry"/></mxCell><mxCell id="pg1-41" value="Hanya pembatalan oleh Pelanggan (cancelledBy = &quot;user&quot;) yang menambah cancelCount." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="550" width="300" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg2" name="SM-02 Status Akun (Soft-ban)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg2-1" value="SM-02 · State Machine Diagram – Status Akun Pelanggan (Soft-ban)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="pg2-2" value="Berdasarkan User.cancelCount &amp;amp; User.bannedUntil di PATCH /api/reservations/[id], GET /api/reservations dan POST /api/reservations." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1300" height="34" as="geometry"/></mxCell><mxCell id="pg2-3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="70" y="262" width="26" height="26" as="geometry"/></mxCell><mxCell id="pg2-4" value="&lt;b&gt;Aktif&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;boleh membuat reservasi baru&lt;br&gt;cancelCount &amp;lt; 5 (atau soft-ban sudah direset)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="180" y="220" width="320" height="110" as="geometry"/></mxCell><mxCell id="pg2-5" value="&lt;b&gt;Soft-ban (Di-suspend)&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:10px&quot;&gt;entry / bannedUntil = sekarang + 1 jam&lt;br&gt;POST /api/reservations → 403 &quot;Akun Anda di-suspend sementara (1 jam)…&quot;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#E1F5FE;strokeColor=#000000;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="220" width="340" height="110" as="geometry"/></mxCell><mxCell id="pg2-6" value="akun dibuat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg2-3" target="pg2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg2-7" value="cancel [Pelanggan] [cancelCount + 1 ≥ 5]&lt;br&gt;/ cancelCount + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg2-4" target="pg2-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg2-8" value="GET /api/reservations [sekarang ≥ bannedUntil]&lt;br&gt;/ cancelCount = 0, bannedUntil = null" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg2-5" target="pg2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg2-9" value="cancel [Pelanggan] [cancelCount + 1 &amp;lt; 5]&lt;br&gt;/ cancelCount + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg2-4" target="pg2-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="276.0" y="150"/><mxPoint x="404.0" y="150"/></Array></mxGeometry></mxCell><mxCell id="pg2-10" value="cancel [Pelanggan]&lt;br&gt;/ cancelCount + 1, bannedUntil = sekarang + 1 jam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="