" height="24" as="geometry"/></mxCell><mxCell id="pg1-51" value="Batas sistem (system boundary)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1426" y="246" width="226" height="34" as="geometry"/></mxCell><mxCell id="pg1-52" value="" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1342" y="297.0" as="sourcePoint"/><mxPoint x="1414" y="297.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg1-53" value="Asosiasi aktor – use case" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1426" y="280" width="226" height="34" as="geometry"/></mxCell><mxCell id="pg1-54" value="" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1342" y="331.0" as="sourcePoint"/><mxPoint x="1414" y="331.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg1-55" value="«include» (base → included) / «extend» (extension → base), garis putus-putus" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1426" y="314" width="226" height="34" as="geometry"/></mxCell><mxCell id="pg1-56" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1342" y="365.0" as="sourcePoint"/><mxPoint x="1414" y="365.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pg1-57" value="Generalisasi (anak → induk)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1426" y="348" width="226" height="34" as="geometry"/></mxCell><mxCell id="pg1-58" value="" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1358" y="387.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="pg1-59" value="Catatan (note)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1426" y="382" width="226" height="34" as="geometry"/></mxCell><mxCell id="pg1-60" value="&lt;b&gt;Catatan implementasi (sesuai kode):&lt;/b&gt;&lt;br&gt;• Autentikasi tanpa JWT/session: pelanggan disimpan di state React, partner di &lt;i&gt;localStorage&lt;/i&gt; (partnerRestoId).&lt;br&gt;• Super Admin hanya berupa REST API (/api/superadmin/*) – belum ada UI &amp;amp; otorisasi.&lt;br&gt;• Endpoint tersedia tetapi belum dipanggil UI: /api/telemetry/visit, /api/profile/xp, /api/profile/[id]/stats, /api/user, /api/auth/logout.&lt;br&gt;• ExploreScreen ada tetapi tidak terhubung ke navigasi; PromoScreen memakai data statis." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1330" y="460" width="330" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg2" name="UC-02 Pelanggan - Reservasi"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1310" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg2-1" value="UC-02 · Use Case Diagram – Pelanggan: Autentikasi, Penjelajahan &amp;amp; Reservasi" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;