e="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1348" y="377.0" width="40" height="24" as="geometry"/></mxCell><mxCell id="pg5-51" value="Catatan (note)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1416" y="372" width="226" height="34" as="geometry"/></mxCell><mxCell id="pg5-52" value="Super Admin saat ini hanya tersedia sebagai REST API: GET /api/superadmin/dashboard, GET &amp;amp; PATCH /api/superadmin/restaurants, GET /api/superadmin/users, POST /api/restaurants. Belum ada UI maupun mekanisme autentikasi/otorisasi. MRR = jumlah SUBSCRIBED × Rp500.000." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1320" y="420" width="330" height="100" as="geometry"/></mxCell><mxCell id="pg5-53" value="Jadwal (vercel.json): auto-cancel &quot;*/10 * * * *&quot;, market-scraper &quot;0 19 * * *&quot;, generate-ai-digest &quot;0 0 * * 1&quot;. Scraper saat ini menghasilkan data tiruan (mock) dan menyimpannya ke ScrapedMarketData." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1320" y="540" width="330" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>