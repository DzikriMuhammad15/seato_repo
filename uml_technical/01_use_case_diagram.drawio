<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram id="pg1" name="UC-01 Ringkasan Sistem"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1280" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg1-1" value="UC-01 · Use Case Diagram – Ringkasan Sistem SEATO" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="pg1-2" value="Gambaran tingkat tinggi seluruh aktor dan kelompok fungsi utama platform SEATO (aplikasi pelanggan &quot;/&quot;, Partner Portal &quot;/admin&quot;, REST API Super Admin, dan tugas terjadwal Vercel Cron)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1300" height="34" as="geometry"/></mxCell><mxCell id="pg1-3" value="Sistem SEATO (Next.js 16 + Prisma + PostgreSQL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#000000;verticalAlign=top;align=center;fontStyle=1;fontSize=14;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="700" height="1110" as="geometry"/></mxCell><mxCell id="pg1-4" value="Autentikasi Akun (Login / Logout)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="320" height="52" as="geometry"/></mxCell><mxCell id="pg1-5" value="Menjelajahi Restoran &amp;amp; Promo (Beranda, Kategori, Terdekat, Detail)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="320" height="52" as=